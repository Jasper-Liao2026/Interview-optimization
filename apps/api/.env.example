# 后端本地配置模板。复制为 .env 后修改。
# 注意：.env 不入库（见根 .gitignore）

# local | staging | production
ENVIRONMENT=local

# 当前里程碑，会显示在前端自检页上
MILESTONE=M8
PROMPT_VERSION=m4.0

LOG_LEVEL=INFO

# 前端源，逗号分隔（不用写 JSON）。
# 本地默认同时放行 localhost 与 127.0.0.1；前端绑哪个都能调通后端。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 宿主端口刻意用 54322（不是 5432）：避开本机可能已有的 Postgres，
# 也让「这个库属于本项目」一眼可辨。与 docker-compose.yml 的端口映射一致。
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/resume_optimizer

# ------------------------------------------------------------------ 观测（M0-8）
# 两个 key 都给齐才会启用 trace 上报；缺任意一个就整体降级为 no-op，不影响业务。
# 宿主机跑 api 时用 3300（compose 里 langfuse-web 映射到宿主 3300；
# 容器内跑 api 时改成 http://langfuse-web:3000，见 docker-compose.yml）
# LANGFUSE_HOST=http://localhost:3300
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev
# Langfuse 项目 ID，仅用于拼 trace 详情页 URL（与 compose 里 LANGFUSE_INIT_PROJECT_ID 一致）
# LANGFUSE_PROJECT_ID=resume-optimizer

# ------------------------------------------------------------------ LLM
# stub 是明确标注的假实现，仅用于验证观测链路，不会发起网络请求。
# 要跑真实调用：改成 openai-compatible 并填 LLM_API_KEY。
# DeepSeek / Moonshot / 通义 / vLLM / Ollama 都走同一套 OpenAI 兼容协议。
LLM_PROVIDER=stub
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# 可选：用于费用估算，单位 USD / 1,000,000 tokens；不填则显示“未配置单价”。
# LLM_INPUT_PRICE_PER_MILLION_USD=0.14
# LLM_OUTPUT_PRICE_PER_MILLION_USD=0.28

# M3：截图须使用支持视觉的 OpenAI 兼容模型；留空复用 LLM 配置。
# VISION_PROVIDER=openai-compatible
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=
# VISION_MODEL=gpt-4.1-mini

# M3：嵌入服务独立于文本模型，固定返回 1536 维向量。
# 默认 stub 只演示哈希检索，不代表真实语义质量。
EMBEDDING_PROVIDER=stub
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# M5: judge 与生成器须配置不同厂商，provider 仅表示协议。
GENERATION_VENDOR=deepseek
JUDGE_PROVIDER=stub
JUDGE_VENDOR=openai
# JUDGE_PROVIDER=openai-compatible
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=gpt-4.1-mini
# JUDGE_MAX_TOKENS=4096
# JUDGE_INPUT_PRICE_PER_MILLION_USD=0.00
# JUDGE_OUTPUT_PRICE_PER_MILLION_USD=0.00
