# Docker Compose configuration. Copy to .env in the repository root.
# Defaults run without API keys. Local Python/Node development instead uses
# apps/api/.env.example and apps/web/.env.example (localhost DB port 54322).
# Container services use their service names, not localhost, for DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/resume_optimizer
ENVIRONMENT=docker
APP_NAME=resume-optimizer-api
SERVICE_ID=resume-optimizer-api
VERSION=0.1.0
MILESTONE=M9
PROMPT_VERSION=m4.1
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT_S=3

# Browser URL is baked into the web image. After changing it, rebuild web.
# If you change ports, update browser URL/CORS_ORIGINS to the same ports.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=54322
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Text generation. stub makes no model requests and marks output as demo.
LLM_PROVIDER=stub
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=2048
GENERATION_VENDOR=deepseek
# LLM_API_KEY=
# Optional USD per million tokens; leave commented for unknown cost.
# LLM_INPUT_PRICE_PER_MILLION_USD=0.14
# LLM_OUTPUT_PRICE_PER_MILLION_USD=0.28

# Real judging must use a different vendor from GENERATION_VENDOR.
JUDGE_PROVIDER=stub
JUDGE_VENDOR=openai
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4.1-mini
JUDGE_MAX_TOKENS=4096
# JUDGE_API_KEY=
# JUDGE_INPUT_PRICE_PER_MILLION_USD=0.40
# JUDGE_OUTPUT_PRICE_PER_MILLION_USD=1.60

# Screenshot parsing inherits LLM_* unless independent vision is configured.
# stub cannot recognize screenshots; use text JD for the no-key demo.
# VISION_PROVIDER=openai-compatible
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=
# VISION_MODEL=gpt-4.1-mini
# VISION_INPUT_PRICE_PER_MILLION_USD=0.40
# VISION_OUTPUT_PRICE_PER_MILLION_USD=1.60

EMBEDDING_PROVIDER=stub
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_S=30
# EMBEDDING_API_KEY=

# Single local user; keep ID aligned with supabase/seed.sql.
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_NAME=本地开发用户
DEV_USER_HEADLINE=后端 / AI 应用开发
REWRITE_MAX_INPUT_CHARS=6000
REWRITE_MAX_CONCURRENCY=4
PDF_TIMEOUT_S=60
# Docker image sets /usr/bin/chromium; local API auto-detects Edge/Chrome.
# CHROMIUM_PATH=/usr/bin/chromium

# Optional local Langfuse: docker compose --profile observability up -d.
# Both keys must be configured to enable export. No keys means no export.
# Docker reaches the published host port through host.docker.internal.
LANGFUSE_HOST=http://host.docker.internal:3300
LANGFUSE_PROJECT_ID=resume-optimizer
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev
